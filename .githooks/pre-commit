#!/usr/bin/env bash
# pre-commit: restricted-content guard.
# Patterns are loaded from .githooks/.blocked (git-ignored, never committed).
# If that file is absent the hook exits silently — create it locally to activate.
# Self-excluded: this hook file and the patterns file are never scanned.
set -e

PATTERNS_FILE='.githooks/.blocked'
SELF='.githooks/pre-commit'

# No patterns file → nothing to enforce.
[[ -f "$PATTERNS_FILE" ]] || exit 0

# Build a single grep -iE pattern from non-comment, non-blank lines.
# tr -d '\r' handles Windows CRLF if the file was edited on Windows.
PATTERN=$(grep -Ev '^[[:space:]]*(#|$)' "$PATTERNS_FILE" \
    | tr -d '\r' | tr '\n' '|' | sed 's/|$//')
[[ -n "$PATTERN" ]] || exit 0

FAIL=0
while IFS= read -r f; do
    [[ -f "$f" ]]                  || continue   # skip deletions / missing
    [[ "$f" == "$SELF" ]]          && continue   # never scan this hook
    [[ "$f" == "$PATTERNS_FILE" ]] && continue   # never scan the patterns file

    if git diff --cached --unified=0 -- "$f" \
        | grep -E '^[+][^+]' \
        | grep -qiE "$PATTERN"; then
        printf '  blocked  %s\n' "$f" >&2
        FAIL=1
    fi
done < <(git diff --cached --name-only)

(( FAIL == 0 )) || {
    printf '\nCommit blocked — remove or redact restricted content and retry.\n' >&2
    exit 1
}
